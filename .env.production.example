# ============================================================================
# TorxOS — CONFIGURAÇÕES DE PRODUÇÃO (VPS HOSTINGER)
# ============================================================================

NODE_ENV=production
PORT=3001
WEB_PORT=3000

# Domínios Públicos do TorxOS
NEXT_PUBLIC_APP_URL="https://torxos.com.br"
NEXT_PUBLIC_API_URL="https://torxos.com.br/api/v1"

# Chave Oficial Google Gemini API (TorxOS AI Mentor)
GEMINI_API_KEY="sua_chave_gemini_aqui"

# PostgreSQL 16
# Substitua pela senha configurada no PostgreSQL da sua VPS
DATABASE_URL="postgresql://torxos_user:SUA_SENHA_FORTE@localhost:5432/torxos_db?schema=public"

# Autenticação JWT (Gere uma chave segura e aleatória)
JWT_SECRET="torxos_super_secret_jwt_key_2026_production_ready"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="torxos_super_refresh_jwt_key_2026_production_ready"
JWT_REFRESH_EXPIRES_IN="7d"

# Asaas API — Gateway de Pagamentos (Recorrência e Pix)
# Produção: https://api.asaas.com/api/v3 | Sandbox: https://sandbox.asaas.com/api/v3
ASAAS_API_URL="https://api.asaas.com/api/v3"
ASAAS_API_KEY="$aact_sua_chave_de_producao_do_asaas"
ASAAS_WEBHOOK_TOKEN="crie_um_token_secreto_para_o_webhook"

# Rastreamento de Tráfego Pago & Conversão (Opcional - Adicione quando for rodar anúncios)
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GTM_ID=""
