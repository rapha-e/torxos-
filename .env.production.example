# ============================================================================
# TorxOS / Evorix — CONFIGURAÇÕES DE PRODUÇÃO (VPS / DOCKER COMPOSE)
# ============================================================================

NODE_ENV=production
PORT=3001
WEB_PORT=3000

# Domínios e URLs Públicas (Substitua pelo seu domínio ou IP da VPS)
NEXT_PUBLIC_APP_URL="https://app.suaempresa.com.br"
NEXT_PUBLIC_API_URL="/api/v1"

# Banco de Dados PostgreSQL 16 (Container evorix_postgres)
POSTGRES_USER=evorix_user
POSTGRES_PASSWORD=gere_uma_senha_muito_forte_aqui_64_chars
POSTGRES_DB=evorix_db
DATABASE_URL="postgresql://evorix_user:gere_uma_senha_muito_forte_aqui_64_chars@evorix_postgres:5432/evorix_db?schema=public"

# Autenticação JWT (Chaves seguras para tokens de sessão)
JWT_SECRET=torxos_super_secret_jwt_key_2026_production_ready
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=torxos_super_refresh_jwt_key_2026_production_ready
JWT_REFRESH_EXPIRES_IN=7d

# Cache & Filas BullMQ (Container evorix_redis)
REDIS_HOST=evorix_redis
REDIS_PORT=6379

# Inteligência Artificial — Google Gemini API
GEMINI_API_KEY=sua_chave_oficial_gemini_aqui

# Gateway WhatsApp (Container evorix_whatsapp / Evolution API)
EVOLUTION_API_URL=http://evorix_whatsapp:8080
EVOLUTION_API_KEY=sua_chave_secreta_whatsapp_evolution_2026

# Imagens Docker pré-compiladas no GitHub Container Registry (GHCR)
DOCKER_IMAGE_API=ghcr.io/seu-usuario/torxos-api:latest
DOCKER_IMAGE_WEB=ghcr.io/seu-usuario/torxos-web:latest

# Armazenamento de Fotos, Laudos e Mídias (S3 / MinIO Local Embutido)
# O MinIO já sobe automaticamente no Docker Compose na porta 9000 (API) e 9001 (Console Web)
MINIO_ENDPOINT=evorix_minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin_s3_torxos
MINIO_SECRET_KEY=torxos_super_minio_s3_secret_2026
MINIO_BUCKET_NAME=torxos-media
S3_ENDPOINT=http://evorix_minio:9000
S3_REGION=us-east-1

# (Opcional) Se quiser usar Cloudflare R2 ou AWS S3 no lugar do MinIO no futuro:
# R2_ACCOUNT_ID=seu_account_id_cloudflare
# S3_ENDPOINT=https://seu_account_id.r2.cloudflarestorage.com
# S3_REGION=auto

# Asaas API — Gateway de Pagamentos e Assinaturas
# Sandbox: https://api-sandbox.asaas.com/v3 | Produção: https://api.asaas.com/v3
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_API_KEY=$aact_sua_chave_de_producao_do_asaas
ASAAS_WEBHOOK_TOKEN=torxos_asaas_webhook_secret_2026

# Rastreamento de Tráfego Pago & Conversão (Opcional)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=
